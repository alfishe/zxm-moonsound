CHIP "dd2"
BEGIN

    DEVICE = "EPM7032STC44-10";

    "CA0"                          : INPUT_PIN  = 22     ; -- LC28
    "CA1"                          : INPUT_PIN  = 25     ; -- LC26
    "CA2"                          : INPUT_PIN  = 27     ; -- LC24
    "CA3"                          : INPUT_PIN  = 30     ; -- LC22
    "CA4"                          : INPUT_PIN  = 44     ; -- LC3
    "CA5"                          : INPUT_PIN  = 42     ; -- LC1
    "CA6"                          : INPUT_PIN  = 38     ;
    "CA7"                          : INPUT_PIN  = 37     ;
    "C_DOS"                        : INPUT_PIN  = 20     ; -- LC30
    "CD0"                          : INPUT_PIN  = 13     ; -- LC14
    "CD1"                          : INPUT_PIN  = 14     ; -- LC15
    "CD2"                          : INPUT_PIN  = 15     ; -- LC16
    "CD3"                          : INPUT_PIN  = 18     ; -- LC32
