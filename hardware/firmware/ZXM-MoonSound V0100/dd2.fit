    "CD5"                          : INPUT_PIN  = 23     ; -- LC27
    "CD6"                          : INPUT_PIN  = 21     ; -- LC29
    "CD7"                          : INPUT_PIN  = 19     ; -- LC31
    "C_IODOS"                      : INPUT_PIN  = 35     ; -- LC17
    "C_IORQ"                       : INPUT_PIN  = 33     ; -- LC19
    "C_IRQ"                        : INPUT_PIN  = 11     ; -- LC12
    "C_MREQ"                       : INPUT_PIN  = 31     ; -- LC21
    "C_M1"                         : INPUT_PIN  = 43     ; -- LC2
    "C_PEVO"                       : INPUT_PIN  = 40     ;
    "C_RD"                         : INPUT_PIN  = 3      ; -- LC6
    "C_RESET"                      : INPUT_PIN  = 39     ;
    "C_WR"                         : INPUT_PIN  = 2      ; -- LC5
    "C_IORQG"                      : OUTPUT_PIN = 34     ; -- LC18
    "CSYM"                         : OUTPUT_PIN = 5      ; -- LC7
    "YA0"                          : OUTPUT_PIN = 10     ; -- LC11
    "YA1"                          : OUTPUT_PIN = 8      ; -- LC10
    "YA2"                          : OUTPUT_PIN = 6      ; -- LC8
    "CSC4_Sel"                     : LOCATION   = LC3    ; -- PIN 44
    "CS7E_Sel"                     : LOCATION   = LC2    ; -- PIN 43

END;

