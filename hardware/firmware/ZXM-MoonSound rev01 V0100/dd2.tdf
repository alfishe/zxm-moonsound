----------------------------------------------------------------------------------------------------------------------------
-- Описание:  Прошивка микросхемы CPLD DD2 звуковой карты ZXM-MoonSound revision 01
-- Автор: Тарасов М.Н. (Mick)
-- Тип CPLD: EPM7032STC44
-- Версия: v1.00  -  07.09.2016. Стартовая версия прошивки, без формирователя вектора прерывания
----------------------------------------------------------------------------------------------------------------------------
TITLE "ZXM-SounCard Middle System Logic";

FUNCTION 2mux1 (a, b, sel) RETURNS (y);

SUBDESIGN DD2
(
  CA[7..1] : INPUT;                              	-- адреса
  CD[7..0] : INPUT; 					-- шина данных

  C_WR    : INPUT;
  C_RD	  : INPUT;
  C_MREQ  : INPUT;
  C_IORQ  : INPUT;
  C_RESET : INPUT;
  C_M1    : INPUT;					-- сигналы управления

  C_DOS : INPUT;  
  C_IODOS : INPUT;					-- сигнал доступа к портам контроллера FDD

  C_IRQ0  : INPUT;					-- вход прерывания от YMF278  
  C_IRQ1  : INPUT;					-- вход прерывания от системного разема  
  C_PEVO : INPUT;                                  	-- вход режимов работы карты  

  C_IORQG : OUTPUT;					-- сигнал блокировки портов

  YA1  : OUTPUT;					-- адреса регистров YMF278	
  YA2  : OUTPUT;					-- адреса регистров YMF278	
  CSYM : OUTPUT;					-- сигнал выбора YMF278
)
VARIABLE

	ENDOS 		: NODE;
	ENIO 		: NODE;

   	CS7E_Sel    : LCELL;
   	CSC4_Sel	: LCELL;
	
	CS_Addr		: NODE;

BEGIN
	-- Формирователь сигнала DOS в зависимости от состояние джампера Pevo
   	ENDOS = (!C_DOS & C_PEVO) # !C_IODOS;

	-- Формирователь сигнала выбора портов 
   	ENIO = C_IORQ # ENDOS # !C_M1 # !C_MREQ;

	-- Формирователь сигнала блокировки портов
	C_IORQG = (CS7E_Sel & CSC4_Sel) # ENDOS;

	---------------------------- YMF278 ---------------------------------
	-- Формирователь сигнала выбора PCM портов 7Eh и 7Fh 
	CS7E_Sel = !(CA[7..1] == B"0111111");

	-- Формирователь сигнала выбора FM портов C4h..C7h 
	CSC4_Sel = !(CA[7..2] == B"110001");

	-- Адреса регистров 
   	YA1 = 2mux1(CA[1], !CA[1], CSC4_Sel);
   	YA2 = 2mux1(!CA[2], CA[2], CSC4_Sel);

	CSYM =  (CS7E_Sel & CSC4_Sel) # ENIO; 

END;





