-- Node name is 'C_IORQG' 
-- Equation name is 'C_IORQG', location is LC018, type is output.
 C_IORQG = LCELL( _EQ001 $ !C_IODOS);
  _EQ001 =  C_IODOS &  CSC4_Sel &  CS7E_Sel
         # !C_DOS &  C_IODOS &  C_PEVO;

-- Node name is 'CSC4_Sel' from file "dd2.tdf" line 39, column 5
-- Equation name is 'CSC4_Sel', location is LC003, type is buried.
CSC4_Sel = LCELL( _EQ002 $  VCC);
  _EQ002 =  CA2 & !CA3 & !CA4 & !CA5 &  CA6 &  CA7;

-- Node name is 'CSYM' 
-- Equation name is 'CSYM', location is LC007, type is output.
 CSYM    = LCELL( _EQ003 $  VCC);
  _EQ003 =  C_DOS &  C_IODOS & !C_IORQ &  C_MREQ &  C_M1 & !CSC4_Sel
         #  C_DOS &  C_IODOS & !C_IORQ &  C_MREQ &  C_M1 & !CS7E_Sel
         #  C_IODOS & !C_IORQ &  C_MREQ &  C_M1 & !C_PEVO & !CSC4_Sel
         #  C_IODOS & !C_IORQ &  C_MREQ &  C_M1 & !C_PEVO & !CS7E_Sel;

-- Node name is 'CS7E_Sel' from file "dd2.tdf" line 38, column 5
-- Equation name is 'CS7E_Sel', location is LC002, type is buried.
CS7E_Sel = LCELL( _EQ004 $  VCC);
  _EQ004 =  CA1 &  CA2 &  CA3 &  CA4 &  CA5 &  CA6 & !CA7;

-- Node name is 'YA0' 
-- Equation name is 'YA0', location is LC011, type is output.
 YA0     = LCELL( CA0 $  GND);

-- Node name is 'YA1' 
-- Equation name is 'YA1', location is LC010, type is output.
 YA1     = LCELL( CA1 $  CSC4_Sel);

-- Node name is 'YA2' 
-- Equation name is 'YA2', location is LC008, type is output.
 YA2     = LCELL(!CA2 $  CSC4_Sel);



